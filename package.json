{
  "name": "dsh-rustxng-web-search",
  "version": "1.1.0",
  "description": "Key-free web search plugin for DeepSeek Harness: downloads the RustXNG metasearch server from its releases, runs it locally, and adds a per-session Web search switch to the composer.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "bundle",
    "web-search",
    "rustxng",
    "searxng",
    "metasearch",
    "key-free"
  ],
  "license": "MIT",
  "author": "Mori",
  "homepage": "https://www.npmjs.com/package/dsh-rustxng-web-search",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/white-sparrow/dsh-rustxng-web-search.git"
  },
  "bugs": {
    "url": "https://github.com/white-sparrow/dsh-rustxng-web-search/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./engine": "./engine.mjs",
    "./rank": "./rank.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check engine.mjs && node --check rank.mjs && node --check scripts/install-engine.mjs && node --check scripts/npm-auth.mjs",
    "test": "node test/rank.mjs",
    "prepublishOnly": "npm run check",
    "prepack": "npm run check",
    "engine": "node scripts/install-engine.mjs",
    "stage": "node scripts/npm-auth.mjs stage publish",
    "stage:list": "node scripts/npm-auth.mjs stage list",
    "stage:view": "node scripts/npm-auth.mjs stage view",
    "stage:approve": "node scripts/npm-auth.mjs stage approve",
    "stage:reject": "node scripts/npm-auth.mjs stage reject",
    "publish:local": "node scripts/npm-auth.mjs publish"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "client.js",
    "engine.mjs",
    "rank.mjs",
    "cordis.patch.yml",
    "scripts/install-engine.mjs",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
